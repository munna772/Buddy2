{
  "name": "buddy-ai-gemini",
  "version": "1.0.0",
  "private": true,
  "description": "Buddy AI backend and Android app build",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "build": "esbuild app.js --bundle --format=iife --platform=browser --target=es2020 --outfile=app.bundle.js",
    "postinstall": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "dotenv": "^16.6.1",
    "@capacitor/core": "6.2.3",
    "@capacitor/android": "6.2.3",
    "@capacitor-community/speech-recognition": "6.0.1",
    "esbuild": "0.28.2",
    "@capacitor/app": "6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "tar": "7.5.22",
    "glob": "14.0.4",
    "minimatch": "11.0.8"
  }
}
